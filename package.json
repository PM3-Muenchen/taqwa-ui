{
  "name": "@pm3/taqwa-ui",
  "version": "0.2.0",
  "description": "Lit web components for Taqwa UI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "pnpm run build:library && pnpm run build:types",
    "build:library": "vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "build-storybook": "storybook build",
    "storybook": "storybook dev --port 6006",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "web-components",
    "lit",
    "tailwindcss",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "dependencies": {
    "lit": "^3.3.3",
    "motion": "^13.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
