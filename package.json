{
  "name": "@pm3/taqwa-ui",
  "version": "0.1.0",
  "description": "Unstyled Base UI components for Taqwa UI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm run build:library && pnpm run build:types && pnpm run build:styles",
    "build:library": "vite build",
    "build:styles": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:types": "tsc --project tsconfig.build.json",
    "build-storybook": "storybook build",
    "storybook": "storybook dev --port 6006",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "base-ui",
    "tailwindcss",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
